<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?android:attr/listPreferredItemHeight"
        android:padding="16dp">

        <!-- Card Principal -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@android:color/white"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_bias="0.3">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="32dp">

                <!-- Ícone -->
                <ImageView
                    android:id="@+id/imgIcon"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="32dp"
                    android:contentDescription="Código de verificação"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_encrypted"
                    app:tint="@color/primary" />

                <!-- Título -->
                <TextView
                    android:id="@+id/txtTitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Verificar Código"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_dark"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/txtDescricao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Digite o código de 6 dígitos enviado para seu email"
                    android:textSize="16sp"
                    android:textColor="@color/text_secondary"
                    android:textAlignment="center"
                    android:layout_marginBottom="40dp"
                    android:lineSpacingExtra="4dp" />

                <!-- Container dos campos de código -->
                <LinearLayout
                    android:id="@+id/layoutCodigoContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="32dp">

                    <!-- Campo 1 -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutCodigo1"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        app:boxStrokeColor="@color/primary"
                        app:boxStrokeWidth="2dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editCodigo1"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:fontFamily="sans-serif-medium"
                            android:inputType="number"
                            android:maxLength="1"
                            android:selectAllOnFocus="true"
                            android:textAlignment="center"
                            android:textColor="@color/text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Campo 2 -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutCodigo2"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        app:boxStrokeColor="@color/primary"
                        app:boxStrokeWidth="2dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editCodigo2"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:fontFamily="sans-serif-medium"
                            android:inputType="number"
                            android:maxLength="1"
                            android:selectAllOnFocus="true"
                            android:textAlignment="center"
                            android:textColor="@color/text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Campo 3 -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutCodigo3"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        app:boxStrokeColor="@color/primary"
                        app:boxStrokeWidth="2dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editCodigo3"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:fontFamily="sans-serif-medium"
                            android:inputType="number"
                            android:maxLength="1"
                            android:selectAllOnFocus="true"
                            android:textAlignment="center"
                            android:textColor="@color/text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Campo 4 -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutCodigo4"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        app:boxStrokeColor="@color/primary"
                        app:boxStrokeWidth="2dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editCodigo4"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:fontFamily="sans-serif-medium"
                            android:inputType="number"
                            android:maxLength="1"
                            android:selectAllOnFocus="true"
                            android:textAlignment="center"
                            android:textColor="@color/text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Campo 5 -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutCodigo5"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        app:boxStrokeColor="@color/primary"
                        app:boxStrokeWidth="2dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editCodigo5"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:fontFamily="sans-serif-medium"
                            android:inputType="number"
                            android:maxLength="1"
                            android:selectAllOnFocus="true"
                            android:textAlignment="center"
                            android:textColor="@color/text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Campo 6 -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutCodigo6"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        app:boxStrokeColor="@color/primary"
                        app:boxStrokeWidth="2dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editCodigo6"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:fontFamily="sans-serif-medium"
                            android:inputType="number"
                            android:maxLength="1"
                            android:selectAllOnFocus="true"
                            android:textAlignment="center"
                            android:textColor="@color/text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <!-- Campo oculto para manter compatibilidade -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutCodigo"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editCodigo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Countdown -->
                <TextView
                    android:id="@+id/txtCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Reenviar código em 05:00"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="16dp"
                    android:fontFamily="sans-serif-medium"
                    android:visibility="visible" />

                <!-- Botão Verificar -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVerificarCodigo"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginBottom="16dp"
                    android:text="Verificar Código"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    app:backgroundTint="@color/primary"
                    app:cornerRadius="16dp"
                    app:elevation="6dp"
                    app:icon="@drawable/ic_check"
                    app:iconGravity="textStart"
                    app:iconSize="20dp"
                    app:iconTint="@android:color/white" />

                <!-- Botão Reenviar -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReenviarCodigo"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Reenviar Código"
                    android:textColor="@color/primary"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="2dp"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/ic_refresh"
                    app:iconGravity="textStart"
                    app:iconSize="18dp"
                    app:iconTint="@color/primary" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>