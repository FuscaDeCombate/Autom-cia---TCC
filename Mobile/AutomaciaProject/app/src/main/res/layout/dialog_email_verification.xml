<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/dialogContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        android:backgroundTint="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Ícone do Firebase/Email -->
            <ImageView
                android:id="@+id/imgEmailIcon"
                android:layout_width="180dp"
                android:layout_height="70dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp"
                android:src="@drawable/ic_firebase"
                android:contentDescription="@string/email_verification_icon" />

            <!-- Título -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Verifique seu email"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:gravity="center"
                android:layout_marginBottom="12dp"
                android:fontFamily="sans-serif-medium" />

            <!-- Mensagem -->
            <TextView
                android:id="@+id/tvMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enviamos um link de confirmação para:"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:layout_marginBottom="8dp"
                android:lineSpacingExtra="4dp" />

            <!-- Email -->
            <TextView
                android:id="@+id/tvEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:gravity="center"
                android:layout_marginBottom="16dp"
                android:fontFamily="sans-serif-medium" />

            <!-- Instruções -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Clique no link do email para ativar sua conta e depois toque em 'Verificar' para continuar."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:layout_marginBottom="20dp"
                android:lineSpacingExtra="4dp" />

            <!-- Informação do Timer -->
            <TextView
                android:id="@+id/tvTimerInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/orange"
                android:gravity="center"
                android:layout_marginBottom="16dp"
                android:fontFamily="sans-serif-medium"
                android:visibility="gone" />

            <!-- Divisor -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginBottom="16dp" />

            <!-- Botão Verificar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerificar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Verificar"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                app:backgroundTint="@color/primary"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_check_circle"
                app:iconGravity="textStart"
                app:iconTint="@color/white"
                android:layout_marginBottom="12dp"
                app:elevation="2dp" />

            <!-- Botão Reenviar Email -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReenviar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Reenviar Email"
                android:textSize="16sp"
                android:textColor="@color/primary"
                app:backgroundTint="@color/primary_light"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_outgoing_mail"
                app:iconGravity="textStart"
                app:iconTint="@color/primary"
                android:layout_marginBottom="12dp"
                style="@style/Widget.Material3.Button.TonalButton" />

            <!-- Botão Voltar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVoltar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Voltar"
                android:textSize="16sp"
                android:textColor="@color/text_secondary"
                app:backgroundTint="@android:color/transparent"
                app:cornerRadius="12dp"
                app:strokeColor="@color/gray_light"
                app:strokeWidth="1dp"
                app:icon="@drawable/ic_arrow_back"
                app:iconGravity="textStart"
                app:iconTint="@color/text_secondary"
                style="@style/Widget.Material3.Button.OutlinedButton" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>