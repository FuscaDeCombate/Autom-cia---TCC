<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_background"
    tools:context=".quickactions.EmergencyActivity">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Header com ícone -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_ambulance"
                    app:tint="@color/danger"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Emergência"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Em caso de emergência médica"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:fontFamily="sans-serif"/>
            </LinearLayout>

            <!-- Botão SAMU - Destaque Principal -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCallSamu"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="LIGAR PARA SAMU"
                android:textSize="16sp"
                android:textStyle="bold"
                app:icon="@drawable/ic_phone"
                app:iconGravity="start"
                app:iconSize="24dp"
                app:iconPadding="12dp"
                android:backgroundTint="@color/danger"
                android:textColor="@color/white"
                app:cornerRadius="12dp"
                app:elevation="2dp"
                android:layout_marginBottom="24dp"
                style="@style/Widget.Material3.Button.Icon"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="192"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/danger"
                android:fontFamily="sans-serif-medium"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp"/>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginBottom="20dp"/>

            <LinearLayout
                android:id="@+id/medicationsHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                
                <!-- Seção Medicamentos -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_medication"
                        app:tint="@color/primary"
                        android:layout_marginEnd="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Medicamentos em Uso"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:fontFamily="sans-serif-medium"/>
                </LinearLayout>

                <!-- RecyclerView para medicamentos -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerMedications"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxHeight="200dp"
                    android:scrollbars="vertical"
                    android:layout_marginBottom="16dp"/>

            </LinearLayout>

            <!-- Botão Copiar Medicamentos -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopyMedications"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Copiar Lista de Medicamentos"
                android:textSize="14sp"
                app:icon="@drawable/ic_content_copy"
                app:iconGravity="start"
                app:iconSize="20dp"
                app:iconPadding="8dp"
                android:textColor="@color/primary"
                app:strokeColor="@color/primary"
                app:strokeWidth="1dp"
                app:cornerRadius="12dp"
                android:backgroundTint="@color/white"
                android:layout_marginBottom="12dp"
                style="@style/Widget.Material3.Button.OutlinedButton.Icon"/>

            <!-- Botão CEATOX -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCallCeatox"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="CEATOX - Intoxicação"
                android:textSize="14sp"
                android:layout_marginBottom="10dp"
                app:icon="@drawable/ic_phone"
                app:iconGravity="start"
                app:iconSize="20dp"
                app:iconPadding="8dp"
                android:textColor="@color/primary"
                app:strokeColor="@color/primary"
                app:strokeWidth="1dp"
                app:cornerRadius="12dp"
                android:backgroundTint="@color/white"
                style="@style/Widget.Material3.Button.OutlinedButton.Icon"/>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</RelativeLayout>